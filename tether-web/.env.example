# Local portal → local Nest API on 3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production: API_URL is read at runtime and wins over NEXT_PUBLIC_API_URL,
# so Cloud Run can set it with --set-env-vars without a rebuild.
# API_URL=https://api.yourgym.example.com

# Force Secure cookies in production-like HTTPS environments
# COOKIE_SECURE=true
