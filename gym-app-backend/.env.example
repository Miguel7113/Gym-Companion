# Database (Supabase Postgres connection string)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Supabase project (used for Auth OTP + Storage)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret-from-supabase-dashboard"

# Local: use 3001 when tether-web is on 3000
# Production: set to the host platform's assigned port if required
PORT=3001

# Comma-separated web origins allowed to call the API (required when NODE_ENV=production)
# Example: https://tether.example.com,http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
